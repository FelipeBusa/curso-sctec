// Snowflake Schema - loja Vitrine
// Abra em https://dbdiagram.io -> cole este conteúdo -> ele desenha o diagrama.
// Diferença para o star: dim_produto NÃO tem mais a coluna categoria --
// ela virou uma dimensão própria (dim_categoria), normalizada.

Table dim_tempo {
  sk_tempo integer [pk]
  data date
  dia integer
  mes integer
  nome_mes text
  trimestre integer
  ano integer
}

Table dim_categoria {
  sk_categoria integer [pk]
  nome_categoria text [note: 'existe 1 vez só, em vez de repetida em cada produto']
}

Table dim_produto {
  sk_produto integer [pk]
  id_produto_origem integer
  nome_produto text
  marca text
  preco_unitario decimal
  custo_unitario decimal
  sk_categoria integer [ref: > dim_categoria.sk_categoria]
}

Table dim_cliente {
  sk_cliente integer [pk]
  id_cliente_origem integer
  nome_cliente text
  cidade text
  segmento text
  data_cadastro date
}

Table dim_loja {
  sk_loja integer [pk]
  id_loja_origem integer
  nome_loja text
  cidade text
  regiao text
}

Table fato_vendas {
  sk_venda integer [pk]
  id_venda_origem integer
  sk_tempo integer [ref: > dim_tempo.sk_tempo]
  sk_produto integer [ref: > dim_produto.sk_produto]
  sk_cliente integer [ref: > dim_cliente.sk_cliente]
  sk_loja integer [ref: > dim_loja.sk_loja]
  quantidade integer
  valor_unitario decimal
  desconto decimal
  status_qualidade text
}
